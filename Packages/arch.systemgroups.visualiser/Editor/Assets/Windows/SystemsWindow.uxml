<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Packages/arch.systemgroups.visualiser/Editor/Assets/Styles/SystemWindow.uss?fileID=7433441132597879392&amp;guid=4facb862eeab27c4ea00349c93793a28&amp;type=3#SystemWindow" />
    <ui:DropdownField label="Select World" index="-1" choices="System.Collections.Generic.List`1[System.String]" name="world-dropdown" />
    <ui:TextField label="Filter" index="-1" name="systems-filter"/>
    <ui:MultiColumnTreeView name="systems-tree" sorting-enabled="true" show-border="true" class="systems-tree">
        <ui:Columns>
            <ui:Column name="name" title="Systems" width="320" stretch="true" is-primary="true" />
            <ui:Column name="entityCount" title="Entity Count" width="100" />
            <ui:Column name="time" title="Time (ms)" width="90" />
        </ui:Columns>
    </ui:MultiColumnTreeView>
    <ui:Button name="enter-play-mode" text="Enter Play Mode" parse-escape-sequences="true" display-tooltip-when-elided="true" />
</ui:UXML>
